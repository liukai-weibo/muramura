# MySQL 运行时内存调优（面向 10 人以内的单机部署）
#
# 背景：本项目数据量极小（约 2 MB、29 张表），但 mysql:8.4 的原厂默认值
# 是按通用服务器设定的，驻留内存曾达 ~525 MB（其中文件缓存仅约 15 MB，
# 其余全部是不可回收的匿名内存），在 1.8 GB 内存的机器上占比过高。
#
# 本文件通过 /etc/mysql/conf.d/ 注入（/etc/my.cnf 末尾有
# `!includedir /etc/mysql/conf.d/`），无需改动基础镜像。
#
# 改动前生效值 → 改动后目标值：
#   performance_schema      1        → OFF
#   max_connections         151      → 40
#   table_open_cache        4000     → 400
#   innodb_log_buffer_size  64 MB    → 8 MB
#   tmp_table_size          16 MB    → 8 MB
#   max_heap_table_size     16 MB    → 8 MB
#
# 有意保持不动的项：
#   innodb_buffer_pool_size = 128 MB（默认值，不显式设置）
#     InnoDB 的性能核心，且为惰性分配；数据量虽小，但降到 64 MB 收益有限
#     且会影响读性能，故不改。
#   key_buffer_size = 8 MB（仅 MyISAM 使用，本项目全为 InnoDB）

[mysqld]

# performance_schema 是 MySQL 8 内存占用的头号来源，且为只读变量，
# 只能在启动时通过配置生效。单人项目不需要运行时性能统计。
performance_schema = OFF

# 连接数：API 使用连接池（MYSQL_POOL_CONNECTION_LIMIT，默认 5 条），
# 10 个用户不会各自占用一条物理连接。40 条的上限用于覆盖：
# API 连接池 + 备份脚本（mysqldump 与 --verify 恢复临时库）+ 迁移服务
# + healthcheck + 人工排查。原厂 151 条浪费内存与文件描述符。
max_connections = 40

# 表缓存：本项目仅 29 张表，4000 条上限远超所需。
table_open_cache = 400

# InnoDB 日志缓冲：原厂 64 MB 面向高写入负载，本项目写入量极低。
innodb_log_buffer_size = 8M

# 内部临时表上限。注意 MySQL 实际取 tmp_table_size 与 max_heap_table_size
# 中较小者，两者必须同时调整，只改其一起不到作用。
tmp_table_size = 8M
max_heap_table_size = 8M

# 线程缓存：保留少量空闲线程以复用，避免频繁创建销毁。
thread_cache_size = 8
