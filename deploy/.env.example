# 云服务器部署用私有环境配置模板。
#
# 用法：复制为同目录下的 .env 后填入真实值；.env 已被 .gitignore 忽略，不会进入仓库。
#   cp deploy/.env.example deploy/.env
#
# 注意：start.sh 用 `awk -F=` 解析 KB_H5_HOST_PORT，务必保持 `KEY=value` 格式，
# 键名与等号之间不要加空格，值不要加引号，也不要写行尾注释。

# ---- MySQL 基础配置 ----
MYSQL_DATABASE=knowledge_base
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password

# ---- 应用账号（容器内以该账号连接业务库）----
MYSQL_APP_USER=knowledge_base_app
MYSQL_APP_PASSWORD=replace-with-app-password

# ---- 迁移账号（仅 migrate 服务使用，负责执行 Migration 与账号收敛）----
MYSQL_MIGRATOR_USER=knowledge_base_migrator
MYSQL_MIGRATOR_PASSWORD=replace-with-migrator-password

# ---- UAT 库账号（migrate 服务用于创建 / 收敛 UAT 库权限）----
MYSQL_UAT_DATABASE=knowledge_base_uat
UAT_MYSQL_APP_USER=knowledge_base_uat_app
UAT_MYSQL_APP_PASSWORD=replace-with-uat-app-password
UAT_MYSQL_MIGRATOR_USER=knowledge_base_uat_migrator
UAT_MYSQL_MIGRATOR_PASSWORD=replace-with-uat-migrator-password

# ---- 连接池 ----
MYSQL_POOL_CONNECTION_LIMIT=5

# ---- 镜像标签：start.sh 会以硬编码的 IMAGE_TAG 覆盖此项，此处仅作兜底 ----
KB_APP_IMAGE_TAG=latest

# ---- 宿主机端口与绑定 ----
# 三类入口默认仅绑定回环地址，公网访问需另行通过 SSH 隧道或反向代理暴露。
KB_H5_BIND_IP=127.0.0.1
KB_H5_HOST_PORT=10086
KB_API_HOST_PORT=32146
KB_MYSQL_HOST_PORT=3306

# ---- AI 密钥存储 ----
# 生产使用 file 模式，写入 knowledge_base_ai_secrets 数据卷；该卷需纳入备份。
AI_SECRET_STORE=file
AI_SECRET_STORE_PATH=/var/lib/knowledge-base/secrets/ai-config.json
