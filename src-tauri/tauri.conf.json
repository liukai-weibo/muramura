{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MaruMaru",
  "version": "0.1.21",
  "identifier": "com.marumaru.knowledgebase",
  "build": {
    "beforeBuildCommand": "corepack pnpm --filter @knowledge-base/client build:h5",
    "frontendDist": "../apps/client/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MaruMaru",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "shadow": false,
        "transparent": false,
        "backgroundColor": "#f2eee7"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFM0QzNjg0OEVCNEQ4RjIKUldUeTJMU09oRFk5L202NjY2RFIrMHlXV2Vib3pKdVRleGU5TE5keXk3RHBSN0ZKRmVXYkhiR28K",
      "endpoints": ["https://gh-proxy.com/https://raw.githubusercontent.com/liukai-weibo/muramura/main/updater.json"],
      "windows": { "installMode": "passive" }
    }
  }
}