    "@tarojs/cli": "4.2.1",
    "@tarojs/vite-runner": "4.2.1",
    "@tauri-apps/cli": "^2.11.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.0",
