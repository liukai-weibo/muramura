{
  "name": "@knowledge-base/client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:h5": "taro build --type h5 --watch",
    "build:h5": "taro build --type h5",
    "tauri:dev": "cd ../.. && corepack pnpm --filter @knowledge-base/client build:h5 && node apps/client/node_modules/@tauri-apps/cli/tauri.js dev --config src-tauri/tauri.dev.conf.json --no-dev-server",
    "tauri:build": "cd ../.. && node apps/client/node_modules/@tauri-apps/cli/tauri.js build --config src-tauri/tauri.conf.json",
    "dev:weapp": "taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp"
  },
  "dependencies": {
    "@knowledge-base/application": "workspace:*",
    "@knowledge-base/contracts": "workspace:*",
    "@knowledge-base/domain": "workspace:*",
    "@nutui/nutui-react-taro": "3.0.20",
    "@rive-app/react-canvas": "^4.30.1",
    "@tanstack/react-virtual": "^3.13.12",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-html": "4.2.1",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "highlight.js": "^11.11.1",
    "lunar-javascript": "^1.7.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-decorators": "^7.24.1",
    "@babel/plugin-transform-class-properties": "^7.24.1",
